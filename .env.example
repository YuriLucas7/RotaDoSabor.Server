# Copie este arquivo para .env e preencha os valores reais.

# Banco de dados PostgreSQL
POSTGRES_DB=rota_do_sabor
POSTGRES_USER=SEU_USUARIO
POSTGRES_PASSWORD=SUA_SENHA
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=rota_do_sabor;Username=SEU_USUARIO;Password=SUA_SENHA

# Autenticação JWT
Jwt__Issuer=RotaDoSabor.Server
Jwt__Audience=RotaDoSabor.Client
Jwt__Key=INFORME_UMA_CHAVE_FORTE_COM_PELO_MENOS_32_CARACTERES
Jwt__ExpirationMinutes=120
